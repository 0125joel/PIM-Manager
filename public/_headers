# The front page is the only page meant for search results. The app pages hold a sign-in screen, no content;
# the robots.txt does not block them, so crawlers can read this header. Each route has an exact rule and a
# `/route/*` rule, the form the Cloudflare documentation shows (it does not document a splat right after letters)
/dashboard
  X-Robots-Tag: noindex, nofollow

/dashboard/*
  X-Robots-Tag: noindex, nofollow

/report
  X-Robots-Tag: noindex, nofollow

/report/*
  X-Robots-Tag: noindex, nofollow

/configure
  X-Robots-Tag: noindex, nofollow

/configure/*
  X-Robots-Tag: noindex, nofollow

/settings
  X-Robots-Tag: noindex, nofollow

/settings/*
  X-Robots-Tag: noindex, nofollow

/help
  X-Robots-Tag: noindex, nofollow

/help/*
  X-Robots-Tag: noindex, nofollow

/demo
  X-Robots-Tag: noindex, nofollow

/demo/*
  X-Robots-Tag: noindex, nofollow

# The *.pages.dev and *.*.pages.dev (preview) addresses serve the same site as pimmanager.com: keep them out of
# search results (the pattern Cloudflare documents for this)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/redirect
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/redirect.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ 'wasm-unsafe-eval' https://alcdn.msauth.net https://aadcdn.msauth.net https://aadcdn.msftauth.net https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://graph.microsoft.com; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com https://login.microsoft.com https://graph.microsoft.com https://api.github.com https://cloudflareinsights.com https://pimmonitor.com; frame-src 'self' https://login.microsoftonline.com; object-src 'none'; base-uri 'self';
